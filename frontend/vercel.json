{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://abstriq.onrender.com/api/$1"
    },
    {
      "source": "/download",
      "destination": "https://abstriq.onrender.com/download"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

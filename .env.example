# ==============================================================================
# Research Abstract Evaluator - Environment Configuration
# ==============================================================================

# LLM Provider selection: mock | gemini | openai | anthropic
# Default is 'mock' so the app runs offline with zero API keys!
LLM_PROVIDER=mock

# Server-side API key for the chosen LLM provider (not needed for mock)
LLM_API_KEY=

# Optional model override (defaults: gemini-1.5-flash, gpt-4o-mini, claude-3-5-haiku-20241022)
LLM_MODEL=

# Low score threshold for automated action (score out of 20)
LOW_SCORE_THRESHOLD=10

# Storage path for results workbook (Excel format)
RESULTS_FILE=data/results.xlsx

# Optional Webhook for automation notifications (Slack / Discord / n8n / custom)
WEBHOOK_URL=

# Optional SMTP settings for email alerts when score is low
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Flask server port (5001 avoids macOS AirPlay receiver on 5000)
PORT=5001
